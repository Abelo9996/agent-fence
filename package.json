{
  "name": "@abelo9996/agent-fence",
  "version": "0.2.0",
  "description": "One permission policy for every coding agent.",
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "agent-fence": "dist/cli.js",
    "agent-fence-shell": "dist/shell.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pretest": "npm run build"
  },
  "keywords": [
    "permissions",
    "policy",
    "sandbox",
    "audit",
    "coding-agent",
    "claude-code",
    "codex",
    "hooks",
    "cli"
  ],
  "author": "Abel Yagubyan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abelo9996/agent-fence.git"
  },
  "homepage": "https://github.com/Abelo9996/agent-fence#readme",
  "bugs": "https://github.com/Abelo9996/agent-fence/issues",
  "dependencies": {
    "cac": "^6.7.14",
    "picomatch": "^4.0.7",
    "smol-toml": "^1.9.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/picomatch": "^4.0.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
